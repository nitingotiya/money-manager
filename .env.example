# Copy this file to .env and fill in the values from Supabase -> Project Settings -> API.
# Leave them empty to run in demo mode (no login, data stays in the browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Filled in automatically by GitHub Actions. Only set these for builds made on your own computer.
# VITE_GITHUB_REPO=your-github-name/money-manager
# VITE_SITE_URL=https://your-github-name.github.io/money-manager/
